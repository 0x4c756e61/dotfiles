{
  "vim_mode": false,
  "ui_font_family": ".SystemUIFont",
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "off",
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "unnecessary_code_fade": 0.7000000476837158,
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "languages": {
    "PHP": {
      "show_edit_predictions": true
    }
  },
  "show_edit_predictions": false,
  "icon_theme": "Catppuccin Mocha",
  "agent": {
    "single_file_review": false,
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking"
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking"
    }
  },
  "auto_update_extensions": {
    "discord-presence": false
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "base_keymap": "VSCode",
  "theme": "Catppuccin Espresso (Blur) [Heavy]",
  "ui_font_size": 17.8,
  "buffer_font_size": 16,
  "buffer_font_family": "Maple Mono NF",
  "terminal": {
    "font_family": "Maple Mono NF"
  },
  "preferred_line_length": 128,
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": [
          "--enable-config"
        ]
      }
    },
    "intelephense": {
      "binary": {
        "path": "/usr/bin/intelephense",
        "arguments": []
      }
    },
    "discord_presence": {
      "initialization_options": {
        "application_id": "1353752276036092057",
        "state": "Keysmashing on {filename}",
        "git_integration": true
      }
    },
    "nil": {
      "initialization_options": {
        "nix": {
          "maxMemoryMB": null,
          "flake": {
            "autoArchive": true,
            "autoEvalInputs": true
          }
        }
      }
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-blur": true,
    "catppuccin-icons": true,
    "colorizer": true,
    "csharp": true,
    "cucumber": true,
    "discord-presence": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "fish": true,
    "fleet-themes": true,
    "git-firefly": true,
    "github-dark-default": true,
    "github-theme": true,
    "glsl": true,
    "html": true,
    "log": true,
    "macos-classic": true,
    "make": true,
    "markdown-oxide": true,
    "material-dark": true,
    "nextjs-react-snippets": true,
    "nginx": true,
    "nix": true,
    "nvim-nightfox": true,
    "palenight": true,
    "php": true,
    "prisma": true,
    "proto": true,
    "python-snippets": true,
    "qml": true,
    "ruff": true,
    "scss": true,
    "serendipity": true,
    "sql": true,
    "superhtml": true,
    "svelte": true,
    "svelte-snippets": true,
    "terraform": true,
    "toml": true,
    "twig": true,
    "typst": true,
    "vscode-dark-plus": true,
    "vscode-great-icons": true,
    "vscode-icons": true,
    "vue": true,
    "xcode-themes": true,
    "zedokai": true,
    "zedwaita": true,
    "zig": true,
    "ziggy": true,
    "jsonl": true
  }
}
